{
  "schema": "release-tools/app/v1",
  "app": "usb-boop",
  "repo": "alexcatdad/usb-boop",
  "checks": ["check"],
  "targets": [
    {
      "id": "macos-arm64",
      "os": "darwin",
      "arch": "arm64",
      "min_os": "14.0",
      "runs": "local",
      "build_task": "build:macos-arm64",
      "validate_task": "validate:macos-arm64",
      "artifacts": [
        { "name": "usb-boop-{version}-macos-arm64.zip", "kind": "zip" }
      ]
    }
  ],
  "migration": { "floor": "2026.9.17.5" },
  "signing": {
    "macos": {
      "targets": ["macos-arm64"],
      "entitlements": "Sources/App/usb-boop.entitlements",
      "notarize": true,
      "staple": true
    }
  },
  "tap": {
    "repo": "alexcatdad/homebrew-tap",
    "kind": "cask",
    "package": "usb-boop"
  }
}
